# AI Jukebox — configuration template.
# Copy to `.env` and fill in your CLASS values (do not commit the real .env).

# Class service endpoints (from class-endpoints.txt). Replace HOST with the class host.
JUKEBOX_TEXT_URL=http://HOST:9001
JUKEBOX_IMAGE_URL=http://HOST:9006
JUKEBOX_MUSIC_URL=http://HOST:9007
JUKEBOX_VOICE_URL=http://HOST:9008

# Shared class API key (server-side only; never commit).
JUKEBOX_API_KEY=replace-me-with-the-class-key

# Optional overrides (defaults are the class models).
# JUKEBOX_TEXT_MODEL=cyankiwi/Qwen3.6-35B-A3B-AWQ-4bit
# JUKEBOX_IMAGE_MODEL=black-forest-labs/FLUX.2-klein-4B
# JUKEBOX_MUSIC_MODEL=acestep-v15-xl-turbo
# JUKEBOX_VOICE_MODEL=chatterbox-v3
# JUKEBOX_VOICE=default

# Storage location (defaults to ./storage, gitignored).
# JUKEBOX_STORAGE=./storage
